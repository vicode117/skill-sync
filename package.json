{
  "name": "skillsync",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "lint": "pnpm --filter @skillsync/desktop lint",
    "typecheck": "pnpm --filter @skillsync/desktop typecheck",
    "test": "pnpm --filter @skillsync/desktop test",
    "build": "pnpm --filter @skillsync/desktop build",
    "dev": "pnpm --filter @skillsync/desktop dev",
    "tauri": "pnpm --filter @skillsync/desktop tauri",
    "cargo:fmt": "cargo fmt --all -- --check",
    "cargo:clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "cargo:test": "cargo test --workspace"
  }
}
